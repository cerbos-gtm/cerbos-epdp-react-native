{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "schedule:earlyMondays",
    "config:recommended",
    "docker:disable",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    ":separateMultipleMajorReleases",
    ":gitSignOff"
  ],
  "automerge": true,
  "automergeSchedule": [
    "after 9am and before 5pm Monday"
  ],
  "major": {
    "automerge": false
  },
  "dependencyDashboard": true,
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "description": "Keep the Cerbos SDK packages in lockstep: @cerbos/embedded-client and @cerbos/embedded-server must match.",
      "matchPackageNames": [
        "/^@cerbos\\//"
      ],
      "groupName": "cerbos-sdk",
      "automerge": false
    }
  ]
}
